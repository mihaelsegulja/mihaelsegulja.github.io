---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ContactDialog from "../components/ContactDialog.astro";
import { themes } from "../data/themes";
import "../styles/globals.css";
import "@fontsource-variable/fira-code/wght.css";
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const {
  title,
  description = "Personal website of Mihael Šegulja, a full-stack software engineer and tech enthusiast.",
  noindex = false,
} = Astro.props;
const pageTitle = title
  ? `${title} | Mihael Šegulja`
  : "Mihael Šegulja | Personal Website";
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{pageTitle}</title>
    <script
      is:inline
      define:vars={{ themeIds: themes.map((theme) => theme.id) }}
    >
      document.documentElement.classList.toggle(
        'typing-enabled',
        !window.matchMedia('(prefers-reduced-motion: reduce)').matches
      );
      try {
        const theme = localStorage.getItem("theme");
        if (themeIds.includes(theme)) {
          document.documentElement.classList.add(`theme-${theme}`);
          document.documentElement.dataset.theme = theme;
        }
      } catch {
        /* Use the default theme when storage is unavailable. */
      }
    </script>
  </head>
  <body
    ><a class="skip-link" href="#content">Skip to content</a><div id="root">
      <Header />
      <main id="content"><slot /></main>
      <Footer />
      <ContactDialog />
    </div></body
  >
</html>
