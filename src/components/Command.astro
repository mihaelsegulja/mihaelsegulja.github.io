---
interface Props {
  text: string;
}
const { text } = Astro.props;
---

<div class="command">
  <button class="command-prefix" type="button" aria-label="Change command prefix">&gt;</button>{' '}<span class="sr-only">{text}</span><span data-command-text aria-hidden="true">{text}</span><span
    class="cli-cursor"
    aria-hidden="true">█</span>
</div>

<script>
  const prefixes = ['>', '$', 'λ', '~', '#', '@', '%'];
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<HTMLElement>('[data-command-text]').forEach((element) => {
      const prefix = element.closest('.command')?.querySelector<HTMLButtonElement>('.command-prefix');
      let prefixIndex = 0;
      prefix?.addEventListener('click', () => {
        prefixIndex = (prefixIndex + 1) % prefixes.length;
        prefix.textContent = prefixes[prefixIndex];
      });

      if (reducedMotion.matches || element.closest('[inert]')) {
        element.dataset.typingReady = '';
        return;
      }
      const text = element.textContent || '';
      let length = 0;
      element.textContent = '';
      element.dataset.typingReady = '';
      const typeNext = () => {
        if (reducedMotion.matches) {
          element.textContent = text;
          return;
        }
        element.textContent = text.slice(0, ++length);
        if (length < text.length) window.setTimeout(typeNext, 28 + Math.random() * 32);
      };
      window.setTimeout(typeNext, 200);
  });
</script>
